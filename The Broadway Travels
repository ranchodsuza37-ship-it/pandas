# Function to generate ad rows
def generate_ads(campaign, ad_group, keywords, final_url, headlines, descriptions, paths):
    ads = []
    for kw in keywords:
        ads.append([campaign, ad_group, kw, "Phrase", final_url] + headlines + descriptions + paths)
    return ads

